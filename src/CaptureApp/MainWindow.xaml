<Window x:Class="CaptureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Capture &amp; Transcription" Height="600" Width="1000" MinWidth="800" MinHeight="450"
        Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar with Recording History -->
        <Border Grid.Column="0" Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#F8F8F8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- New Recording Button -->
                <Border Grid.Row="0" Background="#0078D4" Padding="12,10">
                    <Button x:Name="NewRecordingButton" Height="45" Click="OnNewRecordingClicked" Background="#005A9E" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="New Recording" FontWeight="Bold" FontSize="14" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Processing Queue -->
                <ListBox x:Name="ProcessingListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MaxHeight="200"
                         SelectionChanged="OnProcessingSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="12,12" Background="#E8E8E8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏳" FontSize="14" Margin="0,0,6,0" Foreground="#666" />
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status, Mode=OneWay}" FontSize="11" Foreground="#666" Margin="0,4,0,0" FontStyle="Italic" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- History List -->
                <ListBox x:Name="HistoryListBox" Grid.Row="2" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnHistorySelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,12" Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}" FontSize="11" Foreground="#666" />
                                        <TextBlock Text=" at " FontSize="11" Foreground="#666" Margin="4,0" />
                                        <TextBlock Text="{Binding DisplayTime, Mode=OneWay}" FontSize="11" Foreground="#666" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Settings Button at Bottom -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,10">
                    <Button x:Name="SettingsButton" Height="40" Click="OnSettingsClicked" Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Settings" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter for resizing -->
        <GridSplitter Grid.Column="1" Grid.Row="0" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0" />

        <!-- Main Content Area -->
        <Grid Grid.Column="2" Grid.Row="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75*" />
                <ColumnDefinition Width="25*" />
            </Grid.ColumnDefinitions>

            <!-- Left side: Form fields -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Meeting Name" Grid.Row="0" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBox x:Name="MeetingNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0 0 0 8" />

                <TextBlock Text="Tags" Grid.Row="1" Grid.Column="0" Margin="0 0 12 0" VerticalAlignment="Top" FontWeight="SemiBold" />
                <TextBox x:Name="TagsTextBox" Grid.Row="1" Grid.Column="1" Margin="0 0 0 0" Height="50" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         ToolTip="Enter tags with # (e.g., #meeting #important)" />
            </Grid>

            <!-- Right side: Record button (25% width) -->
            <Border Grid.Column="1" VerticalAlignment="Stretch">
                <Button x:Name="RecordButton" Click="OnRecordClicked" IsDefault="False" Focusable="False"
                        Height="Auto" MinHeight="100" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="RecordButtonIcon" Text="▶" FontSize="32" Margin="0 0 0 8" Foreground="Green" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RecordButtonText" Text="Start" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <!-- Notes Field - fills remaining space -->
        <Grid Grid.Row="1" Margin="0 0 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Notes" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="NotesTextBox" Grid.Row="1" 
                     TextWrapping="Wrap" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Add notes or additional information during recording"
                     Background="#FAFAFA"
                     BorderBrush="#CCCCCC" />
        </Grid>
        </Grid>

        <!-- Status Bar Footer (VS Code style) -->
        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="#3C3C3C" BorderBrush="#2D2D2D" BorderThickness="0,1,0,0">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <Border Grid.Column="0" Background="#007ACC" Padding="8,0" Margin="0,0,1,0">
                    <TextBlock x:Name="StatusTextBlock" Text="Ready" Foreground="White" FontSize="11" VerticalAlignment="Center" />
                </Border>

                <!-- Language Info -->
                <Border Grid.Column="1" Padding="12,0" Margin="0,0,1,0" Background="Transparent" Cursor="Hand" ToolTip="Click to change language in Settings">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="11" Margin="0,0,4,0" Foreground="#CCCCCC" />
                        <TextBlock x:Name="LanguageStatusText" Text="Portuguese" Foreground="#CCCCCC" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Microphone Device -->
                <Border Grid.Column="2" Padding="12,0" Margin="0,0,1,0" Background="Transparent" ToolTip="Recording device">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎤" FontSize="11" Margin="0,0,4,0" Foreground="#CCCCCC" />
                        <TextBlock x:Name="MicrophoneStatusText" Text="Default Device" Foreground="#CCCCCC" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Audio Output Device -->
                <Border Grid.Column="3" Padding="12,0" Margin="0,0,1,0" Background="Transparent" ToolTip="Playback device">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔊" FontSize="11" Margin="0,0,4,0" Foreground="#CCCCCC" />
                        <TextBlock x:Name="AudioOutputStatusText" Text="Default Device" Foreground="#CCCCCC" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Right side spacer -->
                <Border Grid.Column="4" Background="Transparent" />
            </Grid>
        </Border>
    </Grid>
</Window>
