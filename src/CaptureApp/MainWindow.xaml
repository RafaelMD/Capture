<Window x:Class="CaptureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Capture &amp; Transcription" Height="600" Width="1000" MinWidth="800" MinHeight="450"
        Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar with Recording History -->
        <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#F8F8F8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- New Recording Button -->
                <Border Grid.Row="0" Background="#0078D4" Padding="12,10">
                    <Button x:Name="NewRecordingButton" Height="45" Click="OnNewRecordingClicked" Background="#005A9E" Foreground="White" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="New Recording" FontWeight="Bold" FontSize="14" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- History List -->
                <ListBox x:Name="HistoryListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnHistorySelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,12" Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}" FontSize="11" Foreground="#666" />
                                        <TextBlock Text=" at " FontSize="11" Foreground="#666" Margin="4,0" />
                                        <TextBlock Text="{Binding DisplayTime, Mode=OneWay}" FontSize="11" Foreground="#666" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Settings Button at Bottom -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="12,10">
                    <Button x:Name="SettingsButton" Height="40" Click="OnSettingsClicked" Background="Transparent" BorderThickness="1" BorderBrush="#CCCCCC">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Settings" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter for resizing -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E0E0E0" />

        <!-- Main Content Area -->
        <Grid Grid.Column="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0 0 0 12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Meeting Name" Grid.Row="0" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBox x:Name="MeetingNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0 0 0 8" />

            <TextBlock Text="Tags" Grid.Row="1" Grid.Column="0" Margin="0 0 12 8" VerticalAlignment="Top" FontWeight="SemiBold" />
            <TextBox x:Name="TagsTextBox" Grid.Row="1" Grid.Column="1" Margin="0 0 0 8" Height="50" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     ToolTip="Enter tags with # (e.g., #meeting #important)" />

            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 4 0 0">
                <StackPanel Width="220">
                    <TextBlock Text="Language" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageComboBox" DisplayMemberPath="DisplayName" SelectedValuePath="Code" />
                </StackPanel>
                <StackPanel Margin="24 0 0 0" VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="RecordButton" Width="120" Height="40" Click="OnRecordClicked" IsDefault="False" Focusable="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RecordButtonIcon" Text="▶" FontSize="16" Margin="0 0 8 0" Foreground="Green" FontWeight="Bold" />
                            <TextBlock x:Name="RecordButtonText" Text="Start" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0 0 0 12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" x:Name="StatusTextBlock" Text="Idle" TextWrapping="Wrap" FontSize="14" Foreground="#0078D4" />
            </Grid>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
