<Window x:Class="CaptureApp.ProcessingLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing Log" Height="500" Width="700" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#666666" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Processing" FontWeight="Bold" FontSize="18" Foreground="White" />
                <TextBlock x:Name="DateTextBlock" Text="" FontSize="12" Foreground="WhiteSmoke" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Log Content -->
        <Border Grid.Row="1" Background="#F5F5F5" Padding="16">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LogItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                     FontFamily="Consolas" 
                                     FontSize="12" 
                                     Foreground="#333"
                                     Margin="0,2"
                                     TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="#F8F8F8" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusTextBlock" Text="Processing..." FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button x:Name="CloseButton" Width="80" Height="36" Click="OnCloseClicked" IsCancel="True">
                    <TextBlock Text="Close" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
