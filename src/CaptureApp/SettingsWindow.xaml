<Window x:Class="CaptureApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="520" Width="600" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Header="Whisper Configuration" Grid.Row="0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Executable Path" Grid.Row="0" Grid.Column="0" Margin="0 0 12 12" VerticalAlignment="Center" />
                <TextBox x:Name="ExecutablePathTextBox" Grid.Row="0" Grid.Column="1" Margin="0 0 0 12" 
                         ToolTip="Path to faster-whisper-xxl.exe or similar" />

                <TextBlock Text="Model" Grid.Row="1" Grid.Column="0" Margin="0 0 12 12" VerticalAlignment="Center" />
                <TextBox x:Name="ModelTextBox" Grid.Row="1" Grid.Column="1" Margin="0 0 0 12"
                         ToolTip="Model name like 'tiny', 'base', 'small', 'medium', 'large'" />

                <TextBlock Text="Output Folder" Grid.Row="2" Grid.Column="0" Margin="0 0 12 12" VerticalAlignment="Center" />
                <TextBox x:Name="OutputFolderTextBox" Grid.Row="2" Grid.Column="1" Margin="0 0 0 12"
                         ToolTip="Folder where transcripts will be saved" />

                <TextBlock Text="Extra Arguments" Grid.Row="3" Grid.Column="0" Margin="0 0 12 0" VerticalAlignment="Center" />
                <TextBox x:Name="ExtraArgsTextBox" Grid.Row="3" Grid.Column="1" Margin="0"
                         ToolTip="Additional command-line arguments for Whisper" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Jaboo Integration" Grid.Row="1" Margin="0 12 0 0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="API URL" Grid.Row="0" Grid.Column="0" Margin="0 0 12 12" VerticalAlignment="Center" />
                <TextBox x:Name="ApiUrlTextBox" Grid.Row="0" Grid.Column="1" Margin="0 0 0 12"
                         Text="https://izkvewewmtlamozgbqwr.supabase.co/functions/v1/receive-transcription"
                         ToolTip="API endpoint for Jaboo integration" />

                <TextBlock Text="API Key" Grid.Row="1" Grid.Column="0" Margin="0 0 12 0" VerticalAlignment="Center" />
                <TextBox x:Name="ApiKeyTextBox" Grid.Row="1" Grid.Column="1" Margin="0"
                         ToolTip="API key for authentication" />
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Margin="0 12 0 12">
            <TextBlock Text="Last Recording" FontWeight="SemiBold" />
            <TextBlock x:Name="LastRecordingTextBlock" Text="None" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3" Margin="0 0 0 0">
            <Button x:Name="SaveButton" Content="Save" Width="80" Height="32" Margin="0 0 8 0" 
                    Click="OnSaveClicked" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Height="32" 
                    Click="OnCancelClicked" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
