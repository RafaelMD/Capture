<Window x:Class="CaptureApp.TranscriptionViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcription Viewer" Height="600" Width="800" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0078D4" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TitleTextBlock" Text="Transcription" FontWeight="Bold" FontSize="18" Foreground="White" />
                <TextBlock x:Name="DateTextBlock" Text="" FontSize="12" Foreground="WhiteSmoke" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Metadata Section -->
        <Border Grid.Row="1" Background="#F8F8F8" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Meeting Name: " FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock x:Name="MeetingNameTextBlock" Grid.Row="0" Grid.Column="1" Text="" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tags: " FontWeight="SemiBold" Margin="0,8,8,0" />
                <TextBlock x:Name="TagsTextBlock" Grid.Row="1" Grid.Column="1" Text="None" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#666" />
            </Grid>
        </Border>

        <!-- Transcription Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
            <TextBox x:Name="TranscriptionTextBox" 
                     BorderThickness="0" 
                     TextWrapping="Wrap" 
                     IsReadOnly="True"
                     Background="Transparent"
                     FontSize="14"
                     Text="Loading transcription..." />
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#F8F8F8" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Width="100" Height="36" Margin="0,0,8,0" Click="OnCopyClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Copy" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFileButton" Width="120" Height="36" Margin="0,0,8,0" Click="OnOpenFileClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Open File" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Width="80" Height="36" Click="OnCloseClicked" IsCancel="True">
                    <TextBlock Text="Close" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
